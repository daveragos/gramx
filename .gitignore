# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# NOTE: /docs is tracked — it holds the project documentation (ARCHITECTURE,
# TDLIB, ROADMAP, UI). Generated dartdoc output is covered by **/doc/api/ above.

/lib/core/config/app_config.dart

# Release signing. The keystore lives outside the repository; key.properties
# holds its passwords. Losing either means no signed update is possible.
android/key.properties
*.jks
*.keystore

# Working notes, kept out of the repository. They live on disk and keep
# guiding the work; they are not part of what gets published.
docs/
