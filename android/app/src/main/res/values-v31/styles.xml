<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the launch screen themselves: an icon,
         centred on a colour, held until the app's first frame. Left to its
         defaults that colour came from the system theme, so a phone in light
         mode opened gramX on a white screen that cut to black.

         The icon is the ribbon alone, not the launcher icon. The launcher
         icon carries its own dark-grey background, which this screen draws
         as a circle round the mark, and the ribbon inside it is smaller than
         the one Flutter draws next — so the mark shrank, lost its circle and
         jumped at the handover. splash_mark.png is the same artwork the
         app's first frame draws, at the same size in the same place (see
         LaunchReveal), on the same black: the handover is invisible, and the
         mark is what opens into the app. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
