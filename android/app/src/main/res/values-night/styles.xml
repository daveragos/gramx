<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts, before Flutter draws. Black in
         both system themes: see drawable/launch_background.xml. Android 12
         and later draw a launch screen of their own on top of this; its
         colours are set in values-v31/styles.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window behind Flutter once it is running. Flutter paints every
         pixel of it, so this only ever shows for the frame between the launch
         screen leaving and the first Flutter frame — which is why it matches
         the launch screen rather than the system. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
