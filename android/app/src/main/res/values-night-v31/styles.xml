<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the launch screen themselves: an icon,
         centred on a colour, held until the app's first frame. Left to its
         defaults that colour came from the system theme, so a phone in light
         mode opened gramX on a white screen that cut to black.

         Black, and no icon. The app's first frame starts the mark drawing
         itself from nothing (see LaunchReveal), so any icon here would have
         to vanish for the drawing to begin: the launcher icon did, and the
         mark shrank, lost its circle and jumped before drawing itself again.
         Black is the drawing's own first frame, so the handover cannot be
         seen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
