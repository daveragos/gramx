<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts, before Flutter draws. Android 12+
         draws its own launch screen on top (see values-v31/styles.xml). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window behind Flutter. It only shows between the launch screen and
         the first Flutter frame, so it matches the launch screen. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
