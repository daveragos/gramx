<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Talking to Telegram. Declared here rather than inherited from the
         handy_tdlib manifest, so the app's one real permission is visible in
         the app's own file. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Putting a notification on the screen. Android 13+ also requires a
         runtime grant, which Settings asks for when the reader turns
         notifications on — never at launch, where a permission dialog with no
         context is the one every reader declines. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ExoPlayer (via video_player) asks for this to keep the CPU awake
         during playback. This app only ever plays files TDLib already
         downloaded, and never sets a wake mode, so the permission would only
         ever show up in the app's listing without being used. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove"/>

    <!-- Recording a voice message, and the audio track of a round video
         message. Asked for at the moment the reader holds the record button,
         never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Recording a round video message. The one control in the app that opens
         the camera; nothing else here has a viewfinder. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Sending a location. Coarse as well as fine, so a reader who grants only
         approximate location still gets a working control rather than a denial
         — Telegram is being told roughly where somebody is, not navigating.
         Never requested in the background: the app takes one fix and stops. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- The camera is used for one optional feature, so a device without one
         must still be able to install the app. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <application
        android:label="gramX"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- t.me links. Deliberately NOT autoVerify: without a hosted
                 assetlinks.json on t.me — which is Telegram's domain, not
                 ours — Android would fail verification and silently stop
                 offering gramX at all. Unverified, the reader gets a chooser
                 and picks, which is the honest arrangement for an app that
                 opens somebody else's links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="t.me"/>
                <data android:scheme="http" android:host="t.me"/>
                <data android:scheme="https" android:host="telegram.me"/>
                <data android:scheme="http" android:host="telegram.me"/>
                <data android:scheme="https" android:host="telegram.dog"/>
                <data android:scheme="http" android:host="telegram.dog"/>
            </intent-filter>

            <!-- tg:// — the scheme Telegram's own links use once an app has
                 claimed them. Kept separate from the https filter because a
                 single filter matching both would match every https link on
                 the device that had no host. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tg"/>
            </intent-filter>

            <!-- Flutter's own deep linking is off, because this app already
                 has one. app_links reads the intent and parks the URI in
                 PendingDeepLink, which the shell collects once a navigator
                 exists. With both enabled Flutter *also* pushed the raw URI
                 into go_router as a location, and "tg:/resolve?domain=…" is
                 not a route — so a tapped link landed on Page Not Found with
                 a GoException printed under it. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />

            <!-- Sharing a link or some text into gramX, which opens the
                 composer with it. text/plain only: the composer takes photos
                 and videos from the gallery picker, and accepting them here
                 as well would be two ways into one screen with different
                 rules. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ hides other apps unless they are declared here. Without
             these, url_launcher's canLaunchUrl answers false for ordinary links
             and every "open this" control looks broken. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tg"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Handing a downloaded file to whatever app owns it. Without this the
             package-visibility filtering added in Android 11 hides every
             viewer from us, `resolveActivity` answers null, and open_filex
             reports "no app found" for a PDF on a device with three PDF
             readers installed. The mime type is broad because the file can be
             anything Telegram carries; this is a <queries> declaration, not
             the QUERY_ALL_PACKAGES permission, so it grants visibility for
             this intent shape only. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="*/*"/>
        </intent>
    </queries>
</manifest>
