# Template for android/key.properties, which is gitignored.
#
# Copy this to key.properties and fill in the passwords you chose when you ran
# keytool. Nothing here is committed, and nothing here should be shared — the
# keystore plus these passwords are the only way to sign an update that phones
# will accept as the same app.
#
# storeFile must be an absolute path. Gradle does not expand "~".

storePassword=the password you gave for the keystore
keyPassword=the password you gave for the key (often the same)
keyAlias=gramx
storeFile=/home/ragoose/gramx-upload.jks
